# Client ignores
client/node_modules/
client/.next/
client/.env

# Server ignores
server/venv/
server/.env

# Confidential / local corpus PDFs (do not commit)
server/data/
server/**/.env
server/__pycache__/
server/**/__pycache__/
server/**/*.pyc

# Model cache directories (large files, should be downloaded at runtime)
server/model_cache/
server/docling_models/

# Large model files (handled by Git LFS or downloaded during deployment)
server/docling_models/model_artifacts/tableformer/accurate/tableformer_accurate.safetensors
server/docling_models/model_artifacts/tableformer/fast/tableformer_fast.safetensors
*.safetensors

# Google Cloud credentials (sensitive)
server/pdf-tables-extractor-*.json
# Don't exclude all JSON files, only credentials
# *.json

# Local / deploy hints — do not put tokens here (GitHub push protection flags PATs)
runtime.txt

# General
*.log
